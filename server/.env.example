DATABASE_URL=postgres://user:pass@localhost:5432/mockdraft
ADMIN_KEY=change-me
JWT_SECRET=change-me-to-a-random-string
PORT=3001
FRONTEND_URL=http://localhost:5173

# Optional: Discord OAuth. If unset, the Discord sign-in button returns
# a "not_configured" error but the rest of the app works.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:3001/api/auth/discord/callback

# Optional: Google OAuth. Same graceful-degradation behavior as Discord —
# if unset, the Google sign-in button returns "not_configured". Create
# credentials at https://console.cloud.google.com/ → APIs & Services →
# Credentials → OAuth client ID (Web application). Add the redirect URI
# below to the authorized redirect URIs list.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3001/api/auth/google/callback
